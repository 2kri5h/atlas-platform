# =============================================================================
# ATLAS Platform - Production Environment Variables Reference
# =============================================================================

# Server & Security
# -----------------
# Required: Generate a secure 32+ character random string in production
SECRET_KEY=generate_a_strong_random_secret_key_here_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# ----------------------
# For PostgreSQL (e.g., Supabase, Neon, AWS RDS, Render Postgres):
# DATABASE_URL=postgresql://postgres:password@db.example.com:5432/itsp_db
# For SQLite (default if not provided):
DATABASE_URL=sqlite:///./data/itsp.db

# Multi-worker Database Auto-Seeding
# Set to 'false' if running multiple instances/replicas to avoid concurrent seeding race conditions
AUTO_SEED_ON_STARTUP=true

# CORS Configuration
# ------------------
# Comma-separated list of allowed frontend origins, or '*' for unrestricted
# Example: https://atlas.vercel.app,http://localhost:3000
CORS_ORIGINS=*

# AI & Gemini API Keys
# --------------------
GEMINI_API_KEY=
GEMINI_API_KEY_KRISH=
GEMINI_API_KEY_ATHARVA=

# Secret Encryption (REQUIRED in production)
# ------------------------------------------
# Fernet key used to encrypt stored user API keys and Google OAuth tokens.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Runtime environment: "production" enables fail-fast secret checks and
# disables wildcard CORS + vercel.app preview origins.
ENVIRONMENT=production

# Reminder Engine (optional)
# --------------------------
# Triggered daily via POST /api/internal/cron/reminders with header
# X-Cron-Secret. Emails are only sent when SMTP_HOST + SMTP_PORT are set.
CRON_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
REMINDER_FROM=

# Supabase Realtime / Auth (Optional)
# -----------------------------------
SUPABASE_URL=
SUPABASE_API=

# Concurrency & Worker Tuning (for Docker / Gunicorn)
# ----------------------------------------------------
WEB_CONCURRENCY=4
